# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional integrations for AGRI-VISION:
# Open-Meteo and ISRIC SoilGrids are public free APIs and work out-of-the-box without keys.
# ThingSpeak IoT Channel (optional):
THINGSPEAK_CHANNEL_ID=""
THINGSPEAK_READ_API_KEY=""

# Copernicus / Sentinel Hub Satellite Integration (optional):
COPERNICUS_CLIENT_ID=""
COPERNICUS_CLIENT_SECRET=""

# Real SMTP Email Configuration (Nodemailer setup)
# Configure these variables in AI Studio's Secrets Manager or local .env to send real emails to your inbox!
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-google-app-password"
SMTP_SENDER="AgriVision Advisories <mushfiqmq811@gmail.com>"

# Real WhatsApp API Integration (Green API - Recommended for Personal Numbers like +8801731460855)
# Set up a free trial at green-api.com, scan the QR code with +8801731460855, and enter credentials below!
GREEN_API_ID_INSTANCE=""
GREEN_API_TOKEN_INSTANCE=""

# Alternative: Twilio WhatsApp Business API Integration
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

